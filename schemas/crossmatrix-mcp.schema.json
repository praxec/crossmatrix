{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-framework.dev/schemas/crossmatrix-mcp.schema.json",
  "title": "CrossMatrixMcpRequest",
  "description": "LLM-facing MCP contract for crossmatrix. Two entry tools: crossmatrix.command (mutation-first writes) and crossmatrix.query (reads/analyses). Extends a mutation-first request envelope (requestId/modelId/actor + op/payload) to the observation/cell model. Observation-only: command write ops carry observation TOKENS (+evidence), never numbers — the engine rejects numeric weights and unknown tokens (fail-fast, recoverable). Responses carry HATEOAS `links` (legal next ops). Governance (status lifecycle, audit_log, actor) is MCP-LAYER state, not core data.",
  "oneOf": [
    {
      "$ref": "#/$defs/CommandRequest"
    },
    {
      "$ref": "#/$defs/QueryRequest"
    }
  ],
  "$defs": {
    "Actor": {
      "type": "object",
      "required": [
        "actorType",
        "persona"
      ],
      "additionalProperties": false,
      "properties": {
        "actorType": {
          "type": "string",
          "enum": [
            "llm",
            "human",
            "system",
            "classifier"
          ]
        },
        "persona": {
          "type": "string",
          "enum": [
            "model_admin",
            "observer",
            "analyst",
            "reviewer",
            "runtime_validator",
            "jev"
          ]
        }
      }
    },
    "CommandRequest": {
      "type": "object",
      "description": "A single mutation-first write. expectedVersion = optimistic CAS; requestId = idempotency key.",
      "required": [
        "schemaVersion",
        "requestId",
        "modelId",
        "actor",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "expectedVersion": {
          "type": "integer"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "op": {
          "oneOf": [
            {
              "$ref": "#/$defs/OpModelOpen"
            },
            {
              "$ref": "#/$defs/OpModelStatus"
            },
            {
              "$ref": "#/$defs/OpDimensionRegister"
            },
            {
              "$ref": "#/$defs/OpScaleDeclare"
            },
            {
              "$ref": "#/$defs/OpRelationDeclare"
            },
            {
              "$ref": "#/$defs/OpContractionDeclare"
            },
            {
              "$ref": "#/$defs/OpMembersSync"
            },
            {
              "$ref": "#/$defs/OpObserve"
            },
            {
              "$ref": "#/$defs/OpMemberPropose"
            },
            {
              "$ref": "#/$defs/OpEvidenceAttach"
            },
            {
              "$ref": "#/$defs/OpDeprecate"
            }
          ]
        }
      }
    },
    "OpModelOpen": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model.open"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "locked",
            "archived"
          ]
        },
        "stateId": {
          "type": "string"
        },
        "configId": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        },
        "dimensionSetId": {
          "type": "string"
        },
        "dimensionSetVersion": {
          "type": "string"
        },
        "aspect": {
          "type": "string"
        }
      }
    },
    "OpModelStatus": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model.status"
        }
      }
    },
    "OpDimensionRegister": {
      "type": "object",
      "required": [
        "kind",
        "dimensionId",
        "dimensionKind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "dimension.register"
        },
        "dimensionId": {
          "type": "string"
        },
        "dimensionKind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "weightScale": {
          "type": "string"
        },
        "weightSemantics": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OpScaleDeclare": {
      "type": "object",
      "required": [
        "kind",
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scale.declare"
        },
        "scale": {
          "type": "object",
          "description": "A ScaleDef (id, mode, levels[observation,description,value,range]) per the core schema."
        }
      }
    },
    "OpRelationDeclare": {
      "type": "object",
      "required": [
        "kind",
        "relationId",
        "from",
        "to",
        "relationType",
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "relation.declare"
        },
        "relationId": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relationType": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        },
        "coveragePolicy": {
          "type": "string",
          "enum": [
            "none",
            "every_from",
            "every_to",
            "both"
          ]
        }
      }
    },
    "OpContractionDeclare": {
      "type": "object",
      "required": [
        "kind",
        "contractionId",
        "chain"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "contraction.declare"
        },
        "contractionId": {
          "type": "string"
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        },
        "weightCombination": {
          "type": "string",
          "enum": [
            "product",
            "min",
            "qfd_propagate"
          ]
        },
        "weightBySourceMembers": {
          "type": "boolean"
        }
      }
    },
    "OpMembersSync": {
      "type": "object",
      "required": [
        "kind",
        "dimensionId",
        "members"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "members.sync"
        },
        "dimensionId": {
          "type": "string"
        },
        "members": {
          "type": "array",
          "description": "Member rosters {id,label,weightObservation|weight+sourceRef(contentHash)} projected from an authoritative source.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "weightObservation": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "sourceRef": {
                "type": "object"
              },
              "attributes": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "OpObserve": {
      "type": "object",
      "description": "The core write. OBSERVATION-ONLY: `observation` is a token in the relation's scale; `measuredValue` is the measured path (observed provenance + sourceRef). No raw numeric weight is accepted.",
      "required": [
        "kind",
        "relationId",
        "from",
        "to",
        "observation",
        "provenanceClass"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "observe"
        },
        "relationId": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "measuredValue": {
          "type": "number",
          "description": "Only with provenanceClass=observed + sourceRef; engine buckets it."
        },
        "provenanceClass": {
          "type": "string",
          "enum": [
            "normative",
            "observed",
            "inferred"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "sourceRef": {
          "type": "object"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "rationale": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "proposed"
          ],
          "default": "active",
          "description": "`proposed` = a suggestion (e.g. from a classifier) recorded for review. Proposed observations are kept in the document but excluded from every analysis until someone confirms the cell with an ordinary (active) observation."
        }
      }
    },
    "OpMemberPropose": {
      "type": "object",
      "required": [
        "kind",
        "dimensionId",
        "memberId"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "member.propose"
        },
        "dimensionId": {
          "type": "string"
        },
        "memberId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "weightObservation": {
          "type": "string"
        },
        "sourceRef": {
          "type": "object"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "OpEvidenceAttach": {
      "type": "object",
      "required": [
        "kind",
        "targetRef",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence.attach"
        },
        "targetRef": {
          "type": "object",
          "required": [
            "relationId",
            "from",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "relationId": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "observationIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence": {
          "type": "object",
          "description": "An Evidence {sourceRef(contentHash), locator?, excerpt?}."
        }
      }
    },
    "OpDeprecate": {
      "type": "object",
      "required": [
        "kind",
        "targetId",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "deprecate"
        },
        "targetId": {
          "type": "string"
        },
        "targetKind": {
          "type": "string",
          "enum": [
            "member",
            "relation"
          ]
        },
        "supersededBy": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "QModelStatus": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "model.status"
        }
      }
    },
    "QSlice": {
      "type": "object",
      "required": [
        "kind",
        "relationId"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "slice"
        },
        "relationId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "Member id or sourceRef uri."
        },
        "to": {
          "type": "string",
          "description": "Member id or sourceRef uri."
        },
        "rollup": {
          "type": "boolean",
          "description": "Run over the derived rolled-up model."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 500
        },
        "cursor": {
          "type": "string",
          "description": "Opaque numeric-offset cursor."
        }
      }
    },
    "QDescribe": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "describe"
        }
      }
    },
    "QTrace": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "trace"
        },
        "member": {
          "type": "string",
          "description": "Member id, or a sourceRef uri when no explicit `uri` is given."
        },
        "uri": {
          "type": "string",
          "description": "Explicit sourceRef uri lookup key."
        },
        "relationId": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "both"
          ],
          "default": "both"
        },
        "rollup": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "default": 200
        },
        "cursor": {
          "type": "string",
          "description": "Opaque numeric-offset cursor."
        }
      }
    },
    "QExplain": {
      "type": "object",
      "required": [
        "kind",
        "relationId",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "explain"
        },
        "relationId": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      }
    },
    "QGapsNext": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gaps.next"
        },
        "rollup": {
          "type": "boolean"
        }
      }
    },
    "QOrphans": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "gaps.orphans"
        }
      }
    },
    "QCoverage": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "coverage"
        },
        "rollup": {
          "type": "boolean"
        }
      }
    },
    "QStale": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "stale"
        },
        "hashes": {
          "type": "object",
          "description": "key -> current hash, where a member's key is sourceRef.uri, else sourceRef.sourceRef."
        },
        "readFiles": {
          "type": "boolean",
          "description": "Explicit opt-in: sha256 file:// sources inside the project directory."
        },
        "dimensionId": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cursor": {
          "type": "string",
          "description": "Opaque numeric-offset cursor."
        },
        "cellLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 500
        }
      }
    },
    "QConflicts": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "conflicts"
        },
        "relationId": {
          "type": "string"
        }
      }
    },
    "QReport": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "report"
        },
        "relationId": {
          "type": "string",
          "description": "Relation report when given; else the aspect report."
        },
        "title": {
          "type": "string",
          "description": "Aspect report title; defaults to the config label/aspect, else 'Crossmatrix report'."
        }
      }
    },
    "QExport": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "export"
        },
        "format": {
          "type": "string",
          "enum": [
            "model",
            "report",
            "findings"
          ],
          "default": "model"
        },
        "relationId": {
          "type": "string",
          "description": "Used when format=report."
        }
      }
    },
    "QAnalyzeMarginalize": {
      "type": "object",
      "required": [
        "kind",
        "relationId",
        "axis"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analyze.marginalize"
        },
        "relationId": {
          "type": "string"
        },
        "axis": {
          "type": "string",
          "enum": [
            "from",
            "to"
          ]
        },
        "rollup": {
          "type": "boolean"
        }
      }
    },
    "QAnalyzeContract": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analyze.contract"
        },
        "rollup": {
          "type": "boolean"
        }
      }
    },
    "QAnalyzeFindings": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analyze.findings"
        },
        "rollup": {
          "type": "boolean"
        }
      }
    },
    "QValidate": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "validate"
        }
      }
    },
    "QueryRequest": {
      "type": "object",
      "description": "A read/analysis. Never mutates; engine-computed. Reads are scoped slices (never the whole model).",
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "query": {
          "oneOf": [
            {
              "$ref": "#/$defs/QModelStatus"
            },
            {
              "$ref": "#/$defs/QSlice"
            },
            {
              "$ref": "#/$defs/QDescribe"
            },
            {
              "$ref": "#/$defs/QTrace"
            },
            {
              "$ref": "#/$defs/QExplain"
            },
            {
              "$ref": "#/$defs/QGapsNext"
            },
            {
              "$ref": "#/$defs/QOrphans"
            },
            {
              "$ref": "#/$defs/QCoverage"
            },
            {
              "$ref": "#/$defs/QStale"
            },
            {
              "$ref": "#/$defs/QConflicts"
            },
            {
              "$ref": "#/$defs/QReport"
            },
            {
              "$ref": "#/$defs/QExport"
            },
            {
              "$ref": "#/$defs/QAnalyzeMarginalize"
            },
            {
              "$ref": "#/$defs/QAnalyzeContract"
            },
            {
              "$ref": "#/$defs/QAnalyzeFindings"
            },
            {
              "$ref": "#/$defs/QValidate"
            }
          ]
        }
      }
    }
  }
}
